{
  "name": "proy-constr-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest --pool=forks --no-file-parallelism",
    "test:run": "vitest run --pool=forks --no-file-parallelism",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage --pool=forks --no-file-parallelism",
    "test:int": "vitest run tests/integration --pool=forks --no-file-parallelism",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint . --ext .js,.ts --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.8.0",
    "concurrently": "10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.20.0",
    "vitest": "^4.1.6"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2"
  }
}
