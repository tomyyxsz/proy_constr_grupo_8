generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoRol {
  PROFESOR
  AYUDANTE
  ESTUDIANTE
  ADMINISTRADOR
}

enum EstadoAyudantia {
  ACTIVA
  COMPLETADA
  CANCELADA
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
}

enum EstadoImpresion {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  RECHAZADA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model Usuario {
  id String @id @default(uuid()) @db.Uuid
  rut String @db.VarChar(10) @unique
  nombre String @db.VarChar(100)
  apellido String @db.VarChar(100)
  email String @db.VarChar(255) @unique
  password String @db.VarChar(255)
  usuarioRol TipoRol @default(ESTUDIANTE)
  borradoEn DateTime? @db.Timestamp(6)
  creadoEn DateTime @default(now()) @db.Timestamp(6)
  actualizadoEn DateTime @updatedAt @db.Timestamp(6)

  cursosComoProfesor Curso[]
  estudianteCurso EstudianteCurso[]
  grupoEstudiante GrupoEstudiante[]
  ayudantias Ayudantia[]
  inscripcionAyudantia inscripcionAyudantia[]
  reservas Reserva[]
  movimientoStock MovimientoStock[]
  impresionEstudiante Impresion[] @relation("impresionEstudiante")
  impresionAyudante Impresion[] @relation("impresionAyudante")
  usoImpresionSolicitante UsoImpresion[] @relation("usoImpresionSolicitante")
  usoImpresionEstudiante UsoImpresion[] @relation("usoImpresionEstudiante")

}

model Semestre {
  idSemestre String @id @default(uuid()) @db.Uuid
  anio Int 
  periodo Int
  fechaInicio DateTime @db.Timestamp(6)
  fechaFin DateTime @db.Timestamp(6)
  estadoSemestre String @db.VarChar(50) @default("ACTIVO")
  borradoEn DateTime? @db.Timestamp(6)
  creadoEn DateTime @default(now()) @db.Timestamp(6)
  actualizadoEn DateTime @updatedAt @db.Timestamp(6)

  cursos Curso[]
  usoImpresion UsoImpresion[]

}

model Curso {
  idCurso String @id @default(uuid()) @db.Uuid
  nombreCurso String @db.VarChar(255)

  refSemestre String @db.Uuid
  semestre Semestre @relation(fields: [refSemestre], references: [idSemestre])

  refProfesor String @db.Uuid
  profesor Usuario @relation(fields: [refProfesor], references: [id])
  borradoEn DateTime? @db.Timestamp(6)
  creadoEn DateTime @default(now()) @db.Timestamp(6)
  actualizadoEn DateTime @updatedAt @db.Timestamp(6)

  estudianteCurso EstudianteCurso[]
  grupoCurso GrupoCurso[]
  ayudantias Ayudantia[]
  impresiones Impresion[]

}

model EstudianteCurso {
  refCurso String @db.Uuid
  curso Curso @relation(fields: [refCurso], references: [idCurso])

  refEstudiante String @db.Uuid
  estudiante Usuario @relation(fields: [refEstudiante], references: [id])

  @@id([refCurso, refEstudiante])
}

model Ayudantia{
  idAyudantia String @id @default(uuid()) @db.Uuid
  nombreAyudantia String @db.VarChar(255)

  refCurso String @db.Uuid
  curso Curso @relation(fields: [refCurso], references: [idCurso])

  refGrupo String @db.Uuid
  grupo GrupoCurso @relation(fields: [refGrupo], references: [idGrupoCurso])

  refAyudante String @db.Uuid
  ayudante Usuario @relation(fields: [refAyudante], references: [id])

  horario DateTime @db.Timestamp(6)
  cupoMaximo Int
  estadoAyudantia EstadoAyudantia @default(ACTIVA)

  inscripcionAyudantia inscripcionAyudantia[]
}

model GrupoCurso {
  idGrupoCurso String @id @default(uuid()) @db.Uuid
  refCurso String @db.Uuid
  curso Curso @relation(fields: [refCurso], references: [idCurso])

  nombreGrupo String @db.VarChar(100)

  ayudantias Ayudantia[]
  grupoEstudiantes GrupoEstudiante[]


}

model GrupoEstudiante{ // tabla creada a partir de relacion N a N
  refGrupo String @db.Uuid
  grupo GrupoCurso @relation(fields: [refGrupo], references: [idGrupoCurso])

  refEstudiante String @db.Uuid
  estudiante Usuario @relation(fields: [refEstudiante], references: [id])

  @@id([refGrupo, refEstudiante])
}

model inscripcionAyudantia {
  refAyudantia String @db.Uuid
  ayudantia Ayudantia @relation(fields: [refAyudantia], references: [idAyudantia])

  refEstudiante String @db.Uuid
  estudiante Usuario @relation(fields: [refEstudiante], references: [id])

  fechaInscripcion DateTime @default(now()) @db.Timestamp(6)

  estadoAsistencia EstadoAsistencia @default(AUSENTE)

  @@id([refAyudantia, refEstudiante])
}

model BloqueHorario {
  idBloqueHorario String @id @default(uuid()) @db.Uuid
  nroBloque Int
  horaInicio String @db.VarChar(50)
  horaFin String @db.VarChar(50)

  bloqueReservados BloqueReservado[]
}

model BloqueReservado{ // tabla creada a partir de relacion N a N
  idBloque String @db.Uuid
  bloque BloqueHorario @relation(fields: [idBloque], references: [idBloqueHorario])
  idReserva String @db.Uuid
  reserva Reserva @relation(fields: [idReserva], references: [idReserva])

  @@id([idBloque, idReserva])
}

model Reserva{
  idReserva String @id @default(uuid()) @db.Uuid
  fechaReserva DateTime @default(now()) @db.Timestamp(6)
  estadoReserva EstadoReserva @default(PENDIENTE)
  solicitanteNombre String @db.VarChar(50)
  solicitanteEmail String @db.VarChar(100)
  solicitanteApellido String @db.VarChar(50)
  solicitanteRut String @db.VarChar(10)
  refAyudante String @db.Uuid
  ayudante Usuario @relation(fields: [refAyudante], references: [id])

  motivoReserva String @db.VarChar(255)
  creadoEn DateTime @default(now()) @db.Timestamp(6)
  bloqueReservados BloqueReservado[]
}

model Articulo {
  idArticulo String @id @default(uuid()) @db.Uuid
  nombreArticulo String @db.VarChar(100)
  stockActual Int
  unidadMedida String @db.VarChar(50)
  alertaStock Int
  notificarStock Boolean @default(false)
  actualizadoEn DateTime @updatedAt @db.Timestamp(6)

  movimientoStock MovimientoStock[]
  usoImpresion UsoImpresion[]
}

model MovimientoStock{
  idMovimiento String @id @default(uuid()) @db.Uuid

  refArticulo String @db.Uuid
  articulo Articulo @relation(fields: [refArticulo], references: [idArticulo])

  refUsuario String @db.Uuid
  usuario Usuario @relation(fields: [refUsuario], references: [id])

  tipoMovimiento TipoMovimientoStock @default(ENTRADA)

  cambioStock Int
  stockResultante Int
  observacion String @db.VarChar(255)

  creadoEn DateTime @default(now()) @db.Timestamp(6)
}

model Impresion { // tabla clave
  idImpresion String @id @default(uuid()) @db.Uuid
  solicitanteNombre String @db.VarChar(50)
  solicitanteApellido String @db.VarChar(50)
  solicitanteEmail String @db.VarChar(100)
  solicitanteRut String @db.VarChar(10)

  refEstudiante String @db.Uuid
  estudiante Usuario @relation("impresionEstudiante", fields: [refEstudiante], references: [id])
  
  refAyudante String @db.Uuid
  ayudante Usuario @relation("impresionAyudante", fields: [refAyudante], references: [id])

  tipoUsuario String @db.VarChar(50)
  tipoSolicitud String @db.VarChar(50)
  nombreCurso String @db.VarChar(100)

  refCurso String @db.Uuid
  curso Curso @relation(fields: [refCurso], references: [idCurso])

  colorOpcion1 String @db.VarChar(50)
  colorOpcion2 String @db.VarChar(50)
  colorOpcion3 String @db.VarChar(50)

  comentarioTecnico String @db.VarChar(255)
  urlModelo3d String @db.VarChar(255)
  urlModeloStl String @db.VarChar(255)

  comentarioUsuario String @db.VarChar(255)
  estadoImpresion EstadoImpresion @default(PENDIENTE)

  observacionAyudante String @db.VarChar(255)
  motivoRechazo String? @db.VarChar(255) 
  tiempoEstimadoImpresion String @db.VarChar(50)
  inicioImpresion DateTime? @db.Timestamp(6)
  creadoEn DateTime @default(now()) @db.Timestamp(6)


  usoImpresion UsoImpresion[]
}

model UsoImpresion{
  idUsoImpresion String @id @default(uuid()) @db.Uuid
  refImpresion String @db.Uuid
  impresion Impresion @relation(fields: [refImpresion], references: [idImpresion])

  refSolicitante String @db.Uuid
  solicitante Usuario @relation("usoImpresionSolicitante", fields: [refSolicitante], references: [id])

  refEstudiante String @db.Uuid
  estudiante Usuario @relation("usoImpresionEstudiante", fields: [refEstudiante], references: [id])

  refSemestre String @db.Uuid
  semestre Semestre @relation(fields: [refSemestre], references: [idSemestre])

  cantidadFilamento Int
  refArticulo String @db.Uuid
  articulo Articulo @relation(fields: [refArticulo], references: [idArticulo])

  creadoEn DateTime @default(now()) @db.Timestamp(6)
  actualizadoEn DateTime @updatedAt @db.Timestamp(6)
}